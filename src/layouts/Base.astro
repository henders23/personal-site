---
import '@fontsource-variable/orbitron';
import '@fontsource/titillium-web/400.css';
import '@fontsource/titillium-web/400-italic.css';
import '@fontsource/titillium-web/600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Paul Hendrie — learning designer. EAP, in-sessional academic English, and AI-designed learning experiences.' } = Astro.props;
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/approach/', label: 'Approach' },
  { href: '/notice/', label: 'Notice' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#04080d" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <header class="site-header">
      <nav class="page">
        <a href="/" class="wordmark" aria-label="Paul Hendrie — home">PAUL HENDRIE</a>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="lightline" aria-hidden="true"></div>
    </header>

    <main class="page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="page">
        <p>
          <a href="mailto:paulhendrie@gmail.com">paulhendrie@gmail.com</a>
          &nbsp;·&nbsp; <a href="https://github.com/henders23">GitHub</a>
        </p>
        <p class="colophon">
          Set in Orbitron &amp; Titillium. Built with Astro &amp; GSAP.
          The margin annotations are the pedagogy of <em>noticing</em> — glad you did.
          <span class="eol">End of line.</span>
        </p>
      </div>
    </footer>

    <script>
      import '../scripts/motion.js';
    </script>

    <style>
      .site-header { position: relative; }
      .site-header nav {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 1.6rem;
        padding-bottom: 1.4rem;
      }
      .wordmark {
        font-family: var(--font-display);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.28em;
        color: var(--bright);
        border-bottom: none;
        text-shadow: 0 0 14px var(--cyan-glow);
      }
      .site-header ul {
        display: flex;
        gap: 1.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font-family: var(--font-display);
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      @media (max-width: 40rem) {
        .site-header nav { flex-wrap: wrap; row-gap: 0.6rem; }
        .wordmark { letter-spacing: 0.2em; font-size: 0.78rem; white-space: nowrap; }
        .site-header ul { gap: 1rem; flex-wrap: wrap; }
      }
      .site-header ul a { color: var(--text); border-bottom: none; }
      .site-header ul a:hover { color: var(--cyan-core); }
      .site-header ul a[aria-current='page'] {
        color: var(--cyan-core);
        text-shadow: 0 0 12px var(--cyan-glow);
      }
      /* the light cycle trail under the nav — draws in on load */
      .lightline {
        height: 2px;
        margin: 0 auto 2.6rem;
        max-width: calc(var(--measure) + var(--margin-w) + var(--gutter));
        background: linear-gradient(90deg, var(--cyan), rgba(110, 240, 255, 0.15));
        box-shadow: 0 0 12px var(--cyan-glow);
        transform-origin: left center;
        transform: scaleX(0);
        animation: trail 1.1s var(--ease-settle) 0.15s forwards;
      }
      @keyframes trail { to { transform: scaleX(1); } }
      @media (prefers-reduced-motion: reduce) {
        .lightline { animation: none; transform: none; }
      }

      .site-footer {
        border-top: 1px solid var(--panel-edge);
        padding: 2rem 0 3rem;
        font-size: 0.8rem;
        color: var(--dim);
      }
      .site-footer .page { padding-bottom: 0; }
      .colophon { max-width: 52ch; }
      .eol {
        display: block;
        margin-top: 0.6rem;
        font-family: var(--font-display);
        font-size: 0.62rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--cyan);
        opacity: 0.7;
      }
    </style>
  </body>
</html>
