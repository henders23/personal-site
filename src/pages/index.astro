---
import Base from '../layouts/Base.astro';
import Note from '../components/Note.astro';

// The hero redrafts itself: draft trope-language is struck through by hand
// and replaced. Each pass is real markup (<del>/<ins>), so with JS off or
// reduced motion the visitor sees an honest marked-up draft instead.
const passes = [
  {
    keep: 'I ',
    del: 'am passionate about leveraging innovative AI-driven solutions to facilitate transformative learning outcomes.',
    ins: 'design learning experiences. Lately, with AI.',
  },
  {
    keep: 'I ',
    del: 'deliver comprehensive English language support services to diverse student cohorts across the institution.',
    ins: 'teach academic English inside the disciplines, where students actually need it.',
  },
  {
    keep: 'I ',
    del: 'harness the power of cutting-edge generative AI to revolutionise pedagogy.',
    ins: 'use AI carefully, and keep what works.',
  },
];
---
<Base title="Paul Hendrie — learning designer">
  <h1 class="sr-only">Paul Hendrie — I design learning experiences. Lately, with AI.</h1>

  <section class="hero">
    <p class="kicker">Learning design · English for Academic Purposes · AI</p>
    <div class="redraft" aria-hidden="true">
      {passes.map((pass, i) => (
        <p class="pass" data-pass={i}>
          <span class="keep">{pass.keep}</span><del>{pass.del}</del>
          <ins>{pass.ins}</ins>
        </p>
      ))}
    </div>
  </section>

  <section class="doors" data-reveal-group>
    <a class="door reveal" href="/work/">
      <h2 class="settle">Work</h2>
      <p>Five things I designed and what designing them taught me — a walkable
      museum of learning theory, courses on AI for higher education, and an
      EAP coach that lives in a student's pocket.</p>
    </a>
    <a class="door reveal" href="/approach/">
      <h2 class="settle">Approach</h2>
      <p>How I think about scaffolding, noticing, and what AI is actually
      for in learning design. The margin argues with the text.</p>
    </a>
    <a class="door reveal" href="/notice/">
      <h2 class="settle">Notice</h2>
      <p>In-sessional EAP in one minute. Three sentences changed between
      draft and revision — can you spot the moves?</p>
    </a>
  </section>

  <Note>
    If you're wondering why this site keeps writing notes to you in the
    margin: annotation is how academic readers think, and how EAP tutors
    teach. It seemed only right.
  </Note>

  <section class="now">
    <p class="kicker">Now</p>
    <p>Designing AI-assisted learning experiences for higher education —
    most recently a gallery of ninety-three learning theories you can walk
    around inside, and a personal EAP coach. <a href="/about/">More about me</a>.</p>
  </section>

  <style>
    .sr-only {
      position: absolute;
      width: 1px; height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .hero { padding: 3rem 0 4.5rem; min-height: 14rem; }
    .redraft {
      font-size: clamp(1.6rem, 3.4vw, 2.5rem);
      line-height: 1.35;
      font-variation-settings: 'opsz' 55;
      font-weight: 420;
      max-width: 24ch;
      display: grid;
    }
    .pass { grid-area: 1 / 1; margin: 0; }

    /* static fallback (no JS / reduced motion): an honest marked-up draft */
    .pass del { text-decoration: line-through; text-decoration-thickness: 0.06em; color: var(--ink-soft); }
    .pass ins {
      text-decoration: none;
      background: linear-gradient(100deg, transparent 1%, var(--marker) 5%, var(--marker) 95%, transparent 99%);
      padding: 0 0.12em;
      border-radius: 0.15em;
    }
    .pass:not([data-pass='0']) { display: none; }

    /* JS takes over from here */
    :global(html:not(.no-js)) .redraft.armed .pass { display: block; visibility: hidden; }
    :global(html:not(.no-js)) .redraft.armed .pass del { text-decoration: none; background: none; }
    :global(html:not(.no-js)) .redraft.armed .pass ins {
      /* one continuous highlighter swipe, driven by --wash */
      text-decoration: none;
      padding: 0 0.12em;
      background: linear-gradient(100deg, transparent 1%, var(--marker) 5%, var(--marker) 95%, transparent 99%);
      background-repeat: no-repeat;
      background-size: var(--wash, 0%) 100%;
      border-radius: 0.15em;
    }

    .doors {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: 1.5rem;
      border-top: 1px solid var(--hairline);
      padding-top: 2.5rem;
      max-width: var(--measure);
    }
    .door {
      background: none;
      display: block;
      padding: 0.5rem 0.9rem 0.6rem;
      margin: -0.5rem -0.9rem;
      border-radius: 0.4rem;
      transition: background-color 0.3s ease;
    }
    .door:hover { background-color: color-mix(in srgb, var(--support) 55%, transparent); }
    .door h2 { margin: 0 0 0.5rem; font-size: 1.15rem; display: inline-block; }
    .door h2::after { content: ' →'; color: var(--ink-soft); }
    .door p {
      font-family: var(--font-sans);
      font-size: 0.82rem;
      color: var(--ink-soft);
      margin: 0;
    }
    .now { margin-top: 3.5rem; max-width: var(--measure); }
  </style>

  <script>
    import { gsap } from 'gsap';

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const redraft = document.querySelector('.redraft');

    if (redraft && !reduced) {
      // split <del>/<ins> into word spans so strikes wrap naturally and
      // insertions arrive at handwriting speed
      const splitWords = (el, cls) => {
        const words = el.textContent.trim().split(/\s+/);
        el.textContent = '';
        return words.map((w, i) => {
          const s = document.createElement('span');
          s.className = cls;
          s.textContent = w;
          s.style.display = 'inline-block';
          el.append(s, i < words.length - 1 ? ' ' : '');
          return s;
        });
      };

      const passes = [...redraft.querySelectorAll('.pass')].map((pass) => ({
        el: pass,
        del: pass.querySelector('del'),
        ins: pass.querySelector('ins'),
        strikes: splitWords(pass.querySelector('del'), 'strike'),
        inserts: splitWords(pass.querySelector('ins'), 'ins-word'),
      }));

      redraft.classList.add('armed');

      const tl = gsap.timeline({ repeat: -1 });

      passes.forEach(({ el, del, ins, strikes, inserts }) => {
        tl.set(el, { visibility: 'visible' })
          .set(inserts, { display: 'none' })
          .set(del, { clearProps: 'display' })
          .set(ins, { '--wash': '0%' })
          .set(strikes, { '--struck': 0, clearProps: 'width,opacity,marginRight' })
          .call(() => strikes.forEach((s) => s.classList.remove('struck')))
          .fromTo(el, { opacity: 0 }, { opacity: 1, duration: 0.8 })
          // the reader reads the draft…
          .to({}, { duration: 1.9 })
          // …the pencil strikes it through, word by word…
          .to(strikes, {
            '--struck': 1,
            duration: 0.3,
            stagger: 0.07,
            ease: 'power1.inOut',
            onStart() { strikes.forEach((s, i) => gsap.delayedCall(i * 0.07, () => s.classList.add('struck'))); },
          })
          .to({}, { duration: 0.8 })
          // …the deadwood collapses…
          .to(strikes, {
            width: 0,
            opacity: 0,
            marginRight: -4,
            duration: 0.5,
            stagger: 0.03,
            ease: 'power2.in',
          })
          // the struck words are gone; drop their leftover word-spaces too
          .set(del, { display: 'none' })
          // …and the revision arrives under one continuous highlighter swipe.
          .fromTo(
            inserts,
            { display: 'inline-block', opacity: 0, y: 6 },
            { opacity: 1, y: 0, duration: 0.4, stagger: 0.09, ease: 'power2.out' }
          )
          .to(ins, {
            '--wash': '100%',
            duration: 0.09 * inserts.length + 0.4,
            ease: 'power1.inOut',
          }, '<')
          // rest: understatement means knowing when to stop moving
          .to({}, { duration: 4.2 })
          .to(el, { opacity: 0, duration: 0.7 })
          .set(el, { visibility: 'hidden' });
      });
    }
  </script>
</Base>
