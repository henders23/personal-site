---
import Base from '../layouts/Base.astro';
import Note from '../components/Note.astro';
---
<Base title="Paul Hendrie — learning designer">
  <section class="hero">
    <p class="console" aria-hidden="true" data-lines={JSON.stringify([
      '> identity: paul hendrie',
      '> function: designing learning experiences. lately, with ai.',
    ])}>
      <span class="console-text">&gt; identity: paul hendrie<br />&gt; function: designing learning experiences. lately, with ai.</span><span class="cursor"></span>
    </p>

    <h1 class="name">Paul<br />Hendrie</h1>
    <p class="role">Learning design &nbsp;·&nbsp; English for Academic Purposes &nbsp;·&nbsp; AI</p>

    <div class="gridfloor" aria-hidden="true">
      <div class="plane"></div>
      <div class="horizon"></div>
    </div>
  </section>

  <section class="doors" data-reveal-group>
    <a class="door hud-panel reveal" href="/work/">
      <h2>Work</h2>
      <p>Four programs I designed and what building them taught me — a memory
      palace for EAP practitioners, a 217-lesson academic writing course, and
      a constellation of learning theory.</p>
    </a>
    <a class="door hud-panel reveal" href="/approach/">
      <h2>Approach</h2>
      <p>How I think about scaffolding, noticing, and what AI is actually for
      in learning design. The margin argues with the text.</p>
    </a>
    <a class="door hud-panel reveal" href="/notice/">
      <h2>Notice</h2>
      <p>In-sessional EAP in one minute. Three sentences changed between
      draft and revision — can you spot the moves?</p>
    </a>
  </section>

  <div class="prose">
    <Note>
      If you're wondering why this site keeps writing annotations to you in
      the margin: annotation is how academic readers think, and how EAP
      tutors teach. Even on the Grid.
    </Note>

    <section class="now">
      <p class="kicker">Now</p>
      <p>Designing AI-assisted learning experiences for higher education —
      most recently a walkable memory palace for EAP practitioners, and an
      academic writing course two hundred lessons deep. <a href="/about/">More
      about me</a>.</p>
    </section>
  </div>

  <style>
    .hero { padding: 1.5rem 0 0; }

    .console {
      font-family: var(--font-display);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      color: var(--cyan);
      min-height: 2.6em;
      margin-bottom: 2.2rem;
      opacity: 0.85;
    }
    .cursor {
      display: inline-block;
      width: 0.55em;
      height: 1em;
      margin-left: 0.25em;
      vertical-align: -0.15em;
      background: var(--cyan);
      box-shadow: 0 0 8px var(--cyan-glow);
      animation: blink 1.05s steps(1) infinite;
    }
    @keyframes blink { 50% { opacity: 0; } }

    .name {
      font-size: clamp(2.6rem, 7vw, 5rem);
      line-height: 1.04;
      letter-spacing: 0.1em;
      margin: 0;
      color: var(--bright);
      text-shadow:
        0 0 8px rgba(174, 247, 255, 0.6),
        0 0 30px var(--cyan-glow),
        0 0 80px rgba(0, 200, 255, 0.25);
      animation: ignition 1.4s var(--ease-settle) 0.2s backwards;
    }
    @keyframes ignition {
      0% { opacity: 0; text-shadow: none; }
      10% { opacity: 0.8; }
      18% { opacity: 0.2; }
      28% { opacity: 1; }
      37% { opacity: 0.45; }
      48%, 100% { opacity: 1; }
    }

    .role {
      font-family: var(--font-display);
      font-size: 0.72rem;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      color: var(--orange);
      text-shadow: 0 0 16px var(--orange-glow);
      margin: 1.6rem 0 0;
    }

    /* the grid floor, receding to the horizon */
    .gridfloor {
      position: relative;
      height: 200px;
      margin: 2.5rem -1.25rem 0;
      overflow: hidden;
      perspective: 300px;
    }
    .plane {
      position: absolute;
      inset: 0 -40%;
      top: 12%;
      height: 160%;
      background:
        repeating-linear-gradient(90deg, rgba(110, 240, 255, 0.32) 0 1px, transparent 1px 64px),
        repeating-linear-gradient(0deg, rgba(110, 240, 255, 0.32) 0 1px, transparent 1px 64px);
      transform: rotateX(64deg);
      transform-origin: top center;
      animation: gridmove 4.5s linear infinite;
    }
    @keyframes gridmove { to { background-position: 0 64px, 0 64px; } }
    .horizon {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to bottom, var(--void) 0%, rgba(4, 8, 13, 0) 30%),
        linear-gradient(to bottom, rgba(0, 200, 255, 0.18) 10%, transparent 45%);
      pointer-events: none;
    }
    @media (prefers-reduced-motion: reduce) {
      .plane { animation: none; }
      .name { animation: none; }
      .cursor { animation: none; }
    }

    .doors {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
      gap: 1.2rem;
      padding-top: 2.8rem;
    }
    .door {
      display: block;
      padding: 1.1rem 1.2rem 1.2rem;
      border-bottom-width: 1px;
      color: var(--text);
    }
    .door h2 {
      margin: 0 0 0.5rem;
      font-size: 0.82rem;
      letter-spacing: 0.18em;
      color: var(--cyan);
    }
    .door h2::after { content: ' →'; color: var(--dim); }
    .door p { font-size: 0.78rem; color: var(--dim); margin: 0; }
    .door:hover h2 { text-shadow: 0 0 12px var(--cyan-glow); }

    .now { margin-top: 3.5rem; }
  </style>

  <script>
    // Type the console lines, then leave the cursor breathing. Reduced
    // motion (or no JS): the finished lines are already in the markup.
    const consoleEl = document.querySelector('.console');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (consoleEl && !reduced) {
      const lines = JSON.parse(consoleEl.dataset.lines);
      const textEl = consoleEl.querySelector('.console-text');
      textEl.textContent = '';
      let li = 0, ci = 0;
      const tick = () => {
        if (li >= lines.length) return;
        const line = lines[li];
        if (ci <= line.length) {
          textEl.innerHTML = lines.slice(0, li).join('<br />') + (li ? '<br />' : '') + line.slice(0, ci);
          ci += 1;
          setTimeout(tick, 26 + Math.random() * 40);
        } else {
          li += 1; ci = 0;
          setTimeout(tick, 320);
        }
      };
      setTimeout(tick, 350);
    }
  </script>
</Base>
