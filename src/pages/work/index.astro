---
import Base from '../../layouts/Base.astro';
import Note from '../../components/Note.astro';
import { getCollection } from 'astro:content';

const studies = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="Work — Paul Hendrie">
  <div class="prose">
    <p class="kicker">Work</p>
    <h1 class="ignite">Four programs</h1>
    <p>Each is written up the way I'd write a learning design document:
    context, the problem stated precisely, the decisions and their
    reasons, where AI fit, and — in every case — what I'd change.</p>

    <Note>
      The "what I'd change" section is mandatory. A portfolio where nothing
      went sideways is a portfolio that's editing the evidence.
    </Note>

    <ol class="studies" data-reveal-group>
      {studies.map((study) => (
        <li class="reveal">
          <a href={`/work/${study.id}/`} class="hud-panel">
            <h2>{study.data.title}</h2>
            <p class="strapline">{study.data.strapline}</p>
            <p class="context">{study.data.context}</p>
          </a>
        </li>
      ))}
    </ol>
  </div>

  <style>
    .studies {
      list-style: none;
      margin: 3rem 0 0;
      padding: 0;
      counter-reset: study;
      display: grid;
      gap: 1.2rem;
    }
    .studies li { counter-increment: study; }
    .studies a {
      display: grid;
      grid-template-columns: 3rem 1fr;
      grid-template-areas: 'n title' 'n strap' 'n ctx';
      padding: 1.2rem 1.3rem;
      color: var(--text);
    }
    .studies a::before {
      content: counter(study, decimal-leading-zero);
      grid-area: n;
      font-family: var(--font-display);
      font-size: 0.72rem;
      color: var(--orange);
      text-shadow: 0 0 12px var(--orange-glow);
      padding-top: 0.4rem;
    }
    .studies h2 {
      grid-area: title;
      margin: 0;
      font-size: 0.95rem;
      letter-spacing: 0.12em;
      color: var(--cyan);
    }
    .studies a:hover h2 { text-shadow: 0 0 12px var(--cyan-glow); }
    .strapline { grid-area: strap; margin: 0.3rem 0 0; color: var(--text); }
    .context {
      grid-area: ctx;
      font-family: var(--font-display);
      font-size: 0.6rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--dim);
      margin: 0.6rem 0 0;
    }
  </style>
</Base>
